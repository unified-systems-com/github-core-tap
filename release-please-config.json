{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "tap-plugin-github-core",
      "extra-files": [
        {
          "type": "generic",
          "path": "tap_plugin/github_core/tap-plugin.toml"
        },
        {
          "type": "json",
          "path": "tap_plugin/github_core/boot/ci.boot.json",
          "jsonpath": "$.install.plugins[?(@.slug=='github_core')].source.rev"
        }
      ]
    }
  }
}
